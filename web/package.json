{
  "name": "picsky-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Picsky WebUI (React + TypeScript + Vite + Tailwind CSS v4 + shadcn/ui)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('node:fs').writeFileSync('build/.keep','')\"",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,html,css,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,html,css,mjs}\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.4",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-intersection-observer": "^11.0.1",
    "react-router": "^8.4.0",
    "react-virtuoso": "^4.18.16",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
