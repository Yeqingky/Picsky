# Picsky 运行配置示例. 复制为 .env 后按需修改.
# 说明: .env 由 docker compose 读取并注入容器; 直接运行二进制时 Picsky 只读环境变量, 不读 .env.

# 凭据加密主密钥, 必填: 32 字节 base64 (openssl rand -base64 32)
PICSKY_SECRET_KEY=

# --- 数据库 ---
# 驱动: postgres / sqlite. 容器编排默认 postgres (编排内自带 PostgreSQL);
# 直接运行二进制时可保持 sqlite.
PICSKY_DB_DRIVER=postgres
# 连接串. 示例默认指向编排内 PostgreSQL; 修改数据库凭据时, 同步更新此连接串与下面的 POSTGRES_*.
# 注意: 容器内数据库主机名是编排的服务名 `postgres`, 不是 127.0.0.1.
# 自定义连接串示例 (直接运行二进制或切换 SQLite 时):
#   PostgreSQL: host=127.0.0.1 port=5432 user=picsky password=change-me dbname=picsky sslmode=disable
#   SQLite:     /data/picsky.db  (同时把 PICSKY_DB_DRIVER 改为 sqlite)
PICSKY_DB_DSN=host=postgres port=5432 user=picsky password=picsky dbname=picsky sslmode=disable

# PostgreSQL 数据库信息; 示例密码仅供演示, 部署前请改为唯一强口令.
POSTGRES_USER=picsky
POSTGRES_PASSWORD=picsky
POSTGRES_DB=picsky

# 容器内监听地址
PICSKY_LISTEN=0.0.0.0:5214

# 原生 API 前缀与 Lsky Pro 兼容层
PICSKY_API_PREFIX=/api/v1
PICSKY_LSKY_COMPAT_ENABLED=true
# 兼容层前缀; 留空表示根模式 (此时 API 前缀应为 /api/v2)
PICSKY_LSKY_COMPAT_PREFIX=/lsky

# 大文件处理期临时目录 (容器内映射到 ./data/tmp)
PICSKY_TEMP_DIR=/data/tmp
# 内存缓冲上限, 字节 (默认 8 MiB)
PICSKY_UPLOAD_MEMORY_LIMIT=8388608

# 日志级别: debug / info / warn / error
PICSKY_LOG_LEVEL=info
